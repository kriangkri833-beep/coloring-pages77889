  "prompt_template_v2": {
    "version": "v2.1 (2026-11-19)",
    "text": "Create an image: a black-and-white coloring page of {name}, {view}, portrait orientation. Structure: {structure}. Rules: draw every part with ONE single clean outline, never two nested or doubled outlines; separate every part from its neighbours with white space except where two parts physically attach; no outlines crossing through each other; circles and rings must be neat, round and even; no stray lines, tick marks, hooks, dots or flourishes; no solid black fills anywhere (everything is an outline with white inside); no tiny holes, tiny rings, chain links or thin hairlines; no text or numbers. Style: bold, thick clean black outlines of one uniform thickness (every part uses the same line weight) on a pure white background, no grey, no shading, no gradients, no hatching, large simple enclosed areas that are easy for seniors to colour. Composition: the whole object centred on the page, fitting inside 70% of the page width and 60% of the page height, with a wide empty white margin on all four sides; nothing near any edge.",
    "retry_text": "Create an image: redo the same black-and-white coloring page, keeping everything else the same. Corrections: {fixes}",
    "lessons_from": [
      "20 objects, 2026-11-19 run"
    ],
    "lessons": [
      "margin: use numeric limits (70% width / 60% height) not 8%",
      "stray hook/tick lines appear near joins: forbid explicitly",
      "nested/double outlines merge at the sides: forbid, one outline per part",
      "rings drift to ovals: demand neat round",
      "wide objects drift to the page edge: numeric width limit",
      "solid black dots/fills appeared (clock hour marks): demand hollow outlines",
      "tiny holes/rings/chain links appear on sprinklers and chains: forbid, they cannot be coloured",
      "inner details come out hairline next to thick case lines: demand one uniform thick weight",
      "objects drawn inside other objects overlap (basket/spools/scissors): place separately beside each other",
      "side-view objects with moving parts (bicycle) force lines to cross wheels: expect warnings"
    ]
  }
